# ──────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` (it is gitignored).
# ──────────────────────────────────────────────────────────────

# Server
PORT=4000
NODE_ENV=development

# Comma-separated list of allowed browser origins (CORS).
# In dev this is the Vite client. In prod, your real domain(s).
CLIENT_ORIGINS=http://localhost:5174

# Serve the built client (client/dist) from this server (same origin).
# Defaults to true when NODE_ENV=production. Set explicitly to override.
# SERVE_CLIENT=true
# CLIENT_DIST=/absolute/path/to/client/dist   # optional; defaults to ../../client/dist

# ── JWT signing secrets ──
# Generate strong random values, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Use DIFFERENT secrets for access and refresh tokens.
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string
JWT_ACCESS_TTL=900            # access token lifetime, seconds (15 min)
JWT_REFRESH_TTL=2592000       # refresh token lifetime, seconds (30 days)

# ── Google Sign-In ──
# From Google Cloud Console → Credentials → OAuth 2.0 Client ID (Web).
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# ── Admin / CRM API ──
# Shared secret your CRM sends as the `x-admin-key` header (server-to-server).
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Leave blank to disable the API-key path.
ADMIN_API_KEY=

# Admin WEB PAGE login at http://localhost:4000/admin (JWT-protected).
# Set a password to enable the page; leave blank to disable web login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_JWT_TTL=1800           # admin session length, seconds (30 min)

# Admin brute-force protection and access control.
ADMIN_MAX_LOGIN_ATTEMPTS=5   # failures before the IP is locked out
ADMIN_LOCKOUT_MS=900000      # lockout duration (15 min)
ADMIN_IP_ALLOWLIST=          # optional: only these IPs may reach /api/admin at all

# ── Real money wallet (₹). 1 coin of cash = ₹1 ──
MIN_DEPOSIT_INR=50
MIN_WITHDRAWAL_INR=100
MAX_WITHDRAWAL_INR=10000     # per single request

# ── Dev-only login ──
# When "true" AND NODE_ENV=development, allows a passwordless dev login
# endpoint for local testing without Google. MUST be false in production.
ALLOW_DEV_LOGIN=true

# ── Storage backend ──
# 'memory' (default) keeps everything in RAM and resets on restart.
# 'mysql' persists users, coins, and game history. Set up a DB + user, e.g.:
#   CREATE DATABASE coinludo CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#   CREATE USER 'coinludo'@'%' IDENTIFIED BY 'your-password';
#   GRANT ALL PRIVILEGES ON coinludo.* TO 'coinludo'@'%';
# Tables are created automatically on startup.
DB_DRIVER=memory
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=coinludo
DB_PASSWORD=
DB_NAME=coinludo
DB_POOL=10

# ── Manual (UPI) tournament payments ──
# Shown to players so they can pay you directly. The app NEVER processes money —
# players submit their UPI transaction reference (UTR) and you approve it in the
# admin review queue after checking your bank statement.
UPI_ID=
UPI_NAME=CoinLudo
UPI_QR_URL=                   # optional image path, e.g. /upi-qr.png
SUPPORT_URL=                  # optional WhatsApp/CRM link for payment help

# ── Web push notifications (VAPID) ──
# Generate a key pair once:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# The PUBLIC key is sent to browsers; the PRIVATE key must stay secret.
# Leave blank to disable push entirely (nothing else breaks).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@yourdomain.com

# Minutes of lobby before a tournament starts: entries close, players gather
# and everyone is notified with a countdown.
TOURNAMENT_LOBBY_MINUTES=10

# Require an ACTIVE push subscription before a player can take part.
# Tournaments genuinely need it (players must be reachable when their match is
# drawn). Gating PRACTICE too is a conversion trade-off: it demands a scary
# permission before the player has seen any value, and anyone who taps "Block"
# once is locked out until they change browser settings. Set to false to relax.
REQUIRE_PUSH_TOURNAMENTS=true
REQUIRE_PUSH_PRACTICE=true

# ── Practice mode (free play, no account) ──
# Anyone can play a no-stakes game without signing in. The server looks for a
# real opponent first and seats a bot only if nobody arrives in time, so a
# first-time visitor can ALWAYS play instead of staring at an empty lobby.
PRACTICE_ENABLED=true
PRACTICE_BOT_WAIT_MS=20000    # wait this long for a human before the bot joins
GUEST_TTL=21600               # guest session lifetime, seconds (6h)
BOT_MIN_THINK_MS=700          # bot "thinking" pause, lower bound
BOT_MAX_THINK_MS=1400

# ── Game economy ──
SIGNUP_BONUS_COINS=1000       # free coins a new account starts with
DAILY_BONUS_COINS=100         # coins for a daily login
REFERRAL_BONUS_COINS=500      # coins paid to BOTH sides on a referred signup

# ── Matchmaking liquidity (IMPORTANT at launch) ──
# Every extra stake/table-size combination splits your player pool into another
# queue. With few players online, a split pool means NOBODY gets matched. Launch
# with ONE stake and ONE table size; widen only as concurrent players grow.
STAKES=50                     # comma-separated, e.g. 50,100,250
PLAYER_COUNTS=2               # comma-separated subset of 2,3,4
RAKE_BIPS=500                 # platform fee in basis points (500 = 5%)
TURN_TIMEOUT_MS=30000         # auto-skip a player's turn after this long
# A disconnect PAUSES the game until the player returns. They forfeit only if
# one absence outlasts DISCONNECT_GRACE_MS, or all their absences in one game
# add up to more than PAUSE_BUDGET_MS.
DISCONNECT_GRACE_MS=90000
PAUSE_BUDGET_MS=180000
SOCKET_RATE_MAX=60            # max socket events per window, per connection
SOCKET_RATE_WINDOW_MS=1000    # rate-limit window

# ── Real-money features ──
# Cash wallet, UPI deposits, withdrawals and cash tournaments. Keep OFF: India's
# Online Gaming Act 2025 bans online money games. Coins never convert to money.
CASH_ENABLED=false

# ── Coin shop (packs paid on BillTrack Pay, pay.billtrack.me) ──
# id:coins:rupees, comma-separated.
COIN_PACKS=p100:100:100,p250:250:250,p1000:1000:1000
# Pay API, reached server-to-server (same box: the local port).
PAY_API_URL=http://127.0.0.1:4000
# Must equal INTEGRATION_LUDO_KEY on the pay server. openssl rand -hex 32
PAY_API_KEY=
# This app's public origin (where pay sends players back after paying).
PUBLIC_URL=https://ludo.billtrack.me
