# Dependencies
node_modules/
.pnp/
.pnp.js

# Build output
dist/
build/
client/dist/
# vite-plugin-pwa writes this in dev mode; regenerated on every run
client/dev-dist/

# Environment & secrets — NEVER commit these
# Any .env variant (backups, per-environment copies) holds real secrets; only the
# templates are safe to share.
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# Logs
logs/
*.log
npm-debug.log*

# Runtime data / local DB
data/
*.sqlite
*.sqlite3

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Test / coverage
coverage/
.nyc_output/
