# Backend URL. Leave blank in production if the Node server serves this build
# (same origin). Set it only when the API lives on another host.
VITE_SERVER_URL=

# Google OAuth client id — must match the server's GOOGLE_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=

# Your real public URL. Used for WhatsApp/Telegram link previews (OG tags) and
# for building invite links. MUST be the absolute production domain, e.g.
# https://coinludo.app — link previews will not work with a localhost value.
VITE_PUBLIC_URL=http://localhost:5173
